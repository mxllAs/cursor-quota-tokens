{
  "name": "cursor-quota-tokens",
  "displayName": "Cursor Quota & Token Monitor (Cursor 配额与 Token 监控)",
  "description": "实时监控 Cursor 快速请求配额、重置倒计时、Grok/思维模型周额度以及分模型 Token 消耗（支持 GitHub 风格活跃度热力图）。Real-time monitor for Cursor fast requests, reset countdown, Grok/Sand weekly quota, and detailed token metrics.",
  "version": "1.3.1",
  "publisher": "isArray",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxllAs/cursor-quota-tokens.git"
  },
  "bugs": {
    "url": "https://github.com/mxllAs/cursor-quota-tokens/issues"
  },
  "homepage": "https://github.com/mxllAs/cursor-quota-tokens#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "cursor",
    "quota",
    "token",
    "tokens",
    "usage",
    "monitor",
    "tracker",
    "claude",
    "gpt-4",
    "配额",
    "用量"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursor-quota-tokens-view",
          "title": "Cursor 额度",
          "icon": "images/statusbar-icon.svg"
        }
      ]
    },
    "views": {
      "cursor-quota-tokens-view": [
        {
          "type": "webview",
          "id": "cursorQuota.dashboard",
          "name": "Cursor 用量与额度大盘"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorQuota.refresh",
        "title": "刷新 Cursor 额度与 Token",
        "category": "Cursor 额度",
        "icon": "$(refresh)"
      },
      {
        "command": "cursorQuota.openDashboard",
        "title": "打开 Cursor 用量大盘",
        "category": "Cursor 额度",
        "icon": "$(dashboard)"
      },
      {
        "command": "cursorQuota.setToken",
        "title": "手动设置 Cursor 会话令牌 (Session Token)",
        "category": "Cursor 额度"
      },
      {
        "command": "cursorQuota.clearToken",
        "title": "清除已保存的会话令牌 (恢复自动检测)",
        "category": "Cursor 额度"
      },
      {
        "command": "cursorQuota.syncNow",
        "title": "立即同步 Token 数据到云端服务器",
        "category": "Cursor 额度",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "cursorQuota.configureSync",
        "title": "配置云端同步设置 (Sync Settings)",
        "category": "Cursor 额度",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cursorQuota.refresh",
          "when": "view == cursorQuota.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "cursorQuota.syncNow",
          "when": "view == cursorQuota.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "cursorQuota.configureSync",
          "when": "view == cursorQuota.dashboard",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Cursor 额度与 Token 监控配置",
      "properties": {
        "cursorQuota.refreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 120,
          "description": "自动刷新频率（单位：分钟）。"
        },
        "cursorQuota.statusBarFormat": {
          "type": "string",
          "enum": [
            "requests_and_tokens",
            "requests_only",
            "percent_only",
            "tokens_only"
          ],
          "enumDescriptions": [
            "显示剩余请求与今日 Token（如：⚡ 0/2000 | 61.2M tok）",
            "仅显示快速请求次数（如：⚡ 0/2000）",
            "仅显示剩余可用百分比（如：⚡ 余 0%）",
            "仅显示今日 Token 数量（如：⚡ 61.2M Token）"
          ],
          "default": "requests_and_tokens",
          "description": "底部状态栏展示的信息格式。"
        },
        "cursorQuota.lowQuotaThreshold": {
          "type": "number",
          "default": 15,
          "description": "配额余量低预警阈值百分比（低于此值状态栏变黄/变红）。"
        },
        "cursorQuota.sync.enabled": {
          "type": "boolean",
          "default": false,
          "description": "是否开启 Token 统计数据远程云端/服务器自动同步 (Enable remote sync)。"
        },
        "cursorQuota.sync.endpoint": {
          "type": "string",
          "default": "",
          "description": "远程同步接口完整地址 (例如: http://localhost:9527/token-stats/sync 或 https://your-domain.com/api/token-stats/sync)。留空时若检测到 Antigravity 配置则可无缝复用。"
        },
        "cursorQuota.sync.secretKey": {
          "type": "string",
          "default": "",
          "description": "数据同步鉴权密钥（与服务端环境变量 TOKEN_SYNC_SECRET 保持一致）。留空时若检测到 Antigravity 配置则可无缝复用。"
        },
        "cursorQuota.sync.intervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "定时自动同步到服务器的间隔（分钟，最低 1 分钟，默认 10 分钟）。"
        }
      }
    }
  },
  "scripts": {
    "test": "node -c extension.js && node -c src/cursor_auth.js && node -c src/cursor_api.js && node -c src/token_aggregator.js && node -c src/status_bar.js && node -c src/webview_provider.js && node -c src/sync_client.js && node -c src/views/panel.js",
    "package": "npx @vscode/vsce package --no-dependencies -o releases/"
  }
}
